<!-- Main Navbar -->
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
    <div class="container-fluid">
        <!-- Navbar top row -->
        <div class="navbar-top">
            <!-- LuxeStay logo -->
            <a class="navbar-brand" href="/listings">
                <i class="fa-solid fa-person-walking-luggage"></i>
            </a>

            <!-- Mobile hamburger button -->
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNavAltMarkup"
                aria-controls="navbarNavAltMarkup"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <!-- Collapsible navbar content -->
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <!-- Explore link -->
            <div class="navbar-nav">
                <a class="nav-link" href="/listings"> Explore </a>
            </div>

            <!-- Search form -->
            <div class="navbar-nav ms-auto">
                <form
                    class="d-flex search-form"
                    role="search"
                    action="/listings"
                    method="GET"
                >

                    <!-- Search input -->
                    <input
                        class="form-control search-inp"
                        type="search"
                        name="q"
                        placeholder="Search destinations"
                        value="<%= q || '' %>"
                    >

                    <!-- Search button -->
                    <button class="btn search-btn" type="submit" >
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search </button>
                </form>
            </div>

            <!-- Right side navbar links -->
            <div class="navbar-nav ms-auto navbar-links">

                <!-- Create listing -->
                <a class="nav-link" href="/listings/new" >
                    Airbnb your home
                </a>

                <!-- Show login/signup when user is not logged in -->
                <% if(!currUser){ %>

                    <!-- Signup -->
                    <a class="nav-link" href="/signup">
                        <b>SignUp</b>
                    </a>

                    <!-- Login -->
                    <a class="nav-link" href="/login" >
                        <b>Log in</b>
                    </a>

                <% } %>

                <!-- Show logout when user is logged in -->
                <% if(currUser){ %>

                    <!-- Logout -->
                    <a class="nav-link" href="/logout" > Log Out </a>
                <% } %>
            </div>
        </div>
    </div>
</nav>